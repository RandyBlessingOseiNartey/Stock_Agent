# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
venv/

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Node (the frontend has its own .gitignore too)
node_modules/

# Logs and OS cruft
*.log
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json

# ENVIRONMENT VARIABLES — never commit real keys.
# Copy .env.example to .env and fill it in locally.
.env
.env.*
!.env.example
env.yaml
!env.yaml.example
