# StockAgent — environment template.
# Copy to .env in the repo root and fill in real values. .env is gitignored;
# never commit it.
#
#     cp .env.example .env
#
# All market data comes from free providers (yfinance / SEC via OpenBB), so
# there is no paid market-data key here.

# ── Required ────────────────────────────────────────────────────────

# Ollama Cloud API key. Every agent's model is served from https://ollama.com.
# Create one at https://ollama.com (Settings → Keys).
OLLAMA_API_KEY=

# Tavily web/news search, used by the `tavily` tool in all three features.
# Free tier at https://tavily.com. If this is missing or the call fails, the
# tool falls back to DuckDuckGo automatically (see tool_set/tavily_search_tool.py).
TAVILY_API_KEY=

# Google Gemini key — required by tool_set/peers_agent.py, the nested
# sub-agent that discovers peer/competitor tickets. Separate from Ollama.
# Create one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── Required for Chat only ──────────────────────────────────────────

# PostgreSQL, used solely by the Chat feature for conversation memory.
# Must use the asyncpg driver. Deep Research and Terminal run without it —
# the app starts fine and only Chat is unavailable if this is unset.
# Local example:    postgresql+asyncpg://postgres:postgres@localhost:5432/stockagent
# Supabase example: postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ── Optional ────────────────────────────────────────────────────────

# Extra browser origins allowed to call the API (comma-separated).
# Defaults to http://localhost:5173,http://127.0.0.1:5173 when unset.
# CORS_ALLOW_ORIGINS=http://localhost:5173

# Frontend only (put in frontend/.env.local, not here): overrides the dev
# placeholder user id sent as the X-User-Id header. See "Authentication".
# VITE_USER_ID=00000000-0000-0000-0000-000000000001
