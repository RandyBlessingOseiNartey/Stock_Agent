# Environment variables for Cloud Run, passed with:
#     gcloud run deploy ... --env-vars-file env.yaml
#
# Copy to env.yaml and fill in. env.yaml is gitignored and excluded from the
# build upload (.gcloudignore) — never commit it.
#
#     cp env.yaml.example env.yaml
#
# Why a file instead of --set-env-vars: that flag splits on commas, so any
# value containing a comma silently breaks. A YAML file has no such problem.
# Values must be strings — keep the quotes.

OLLAMA_API_KEY: "your-ollama-cloud-key"
TAVILY_API_KEY: "your-tavily-key"
GOOGLE_API_KEY: "your-gemini-key"

# Chat only. Omit this line entirely to deploy without Chat: the service still
# runs, /api/health reports database:false, and Chat returns a clean 503.
DATABASE_URL: "postgresql+asyncpg://user:password@host:5432/postgres"
